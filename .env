# Скопируйте в .env и заполните. .env в git не попадает.

ENV=local
DEBUG=true
TZ=Europe/Moscow
# На сервере: true. Многие хостинги задают PORT автоматически, тогда режим
# включится и без этой переменной.
HOSTED_MODE=false
# Внешний порт хостинга. Обычно его задаёт сама платформа.
PORT=
# Если хостинг даёт только IP:порт и не имеет Custom Domains, создайте
# Cloudflare Tunnel в Zero Trust и укажите токен здесь. Тогда оба домена
# будут опубликованы туннелем, запущенным на хостинге.
CLOUDFLARED_TUNNEL_TOKEN=eyJhIjoiZWM3YzVkOTJlNWNhYTI1YTVhNTQ3OTgxYTI5MGUxNmYiLCJzIjoiL1FtV2E3U3BXeFQ4MEVBSktkMlNsOWowOHVOZzBMbWYyOSs0V3hDb3hyVT0iLCJ0IjoiOWE1MDM2ZWItY2E5OC00ODNjLWFjYTYtYWI2ZDVkYzhhM2M1In0=
# На хостинге без отдельного build-шагa run.py может установить зависимости сам.
AUTO_INSTALL_DEPENDENCIES=true

# --- база ---
# Локально sqlite, в проде: postgresql+asyncpg://user:pass@host:5432/shop
DATABASE_URL=
DB_AUTO_CREATE=true
DB_ECHO=false

# --- боты ---
BOT_TOKEN=8838707397:AAGyZNOjQgV7QnRqcnSuCe9PPDDqgpwXxmE
SUPPORT_BOT_TOKEN=8899411808:AAFgLLc3O2SzPOLcc-gfAsxuCHuxBSdf108
BOT_USERNAME=@AntarcticShop_Robot
SUPPORT_BOT_USERNAME=@Antarcticsup_robot
# Прокси до api.telegram.org, если Telegram с сервера недоступен.
# Понимаются оба формата записи: socks5://user:pass@host:1080 и
# socks5://host:1080:user:pass (как выдают продавцы). Пусто = напрямую.
BOT_PROXY=socks5://196.18.13.244:8000:d1yD7q:FtFkb0


# Очистка купленного аккаунта использует Auth Key и DC ID из карточки заказа.
# API-идентификатор Telethon встроен в клиент и покупателю не нужен.


# --- админка (локально) ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Секрет для подписи сессионной куки. Сгенерировать: python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_SECRET=54c258cdaef933cf90e548af73f5a5ffd652223060d565daffc5bfeba56ba780
ADMIN_BASE_URL=http://127.0.0.1:8080
# Первый вход. Если админов в базе нет — создастся при старте.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# --- сайт и мини-апп ---
WEBAPP_BASE_URL=https://antarctic.cfd/app
WEB_HOST=127.0.0.1
WEB_PORT=8081
WEB_BASE_URL=https://antarctic.cfd
WEB_SECRET=9f234ccf5bcb4b9d9fa4363f4d84e589c7ccadf7d4b58fb0dbf79d77ccbe9a31
# Google OAuth, создаётся в Google Cloud Console.
