# Режим запуска
ENV=prod
DEBUG=false
# auto: Windows = локальный запуск с Tunnel; Linux + ENV=prod = хостинг
HOSTED_MODE=auto
# Хостинг обычно сам задаёт PORT. Если не задаёт, оставьте 80 для gunicorn.
PORT=80
AUTO_INSTALL_DEPENDENCIES=true
RUN_BOT=true
RUN_SUPPORT_BOT=true

# База. Для постоянного production-хранилища лучше PostgreSQL и volume.
DATABASE_URL=sqlite+aiosqlite:///./data/shop.db
DB_AUTO_CREATE=true
DB_ECHO=false

# Telegram
BOT_TOKEN=
SUPPORT_BOT_TOKEN=
BOT_USERNAME=
SUPPORT_BOT_USERNAME=
BOT_PROXY=

# Админка
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_SECRET=
ADMIN_BASE_URL=https://dabbackwood.cfd

# Сайт и Mini App
WEB_HOST=0.0.0.0
WEB_PORT=8081
WEB_BASE_URL=https://antarctic.cfd
WEBAPP_BASE_URL=https://antarctic.cfd/app
WEB_SECRET=

# Google OAuth (необязательно)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://antarctic.cfd/auth/google/callback

# LZT Market
LZT_TOKEN=
LZT_BASE_URL=https://prod-api.lzt.market
LZT_BALANCE_ID=
LZT_PROXY=

# Оплата (необязательно каждый провайдер)
CRYPTOBOT_TOKEN=
XROCKET_TOKEN=
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Канал отзывов
REVIEWS_CHANNEL_ID=

# Заполняется только если домены публикуются через Cloudflare Tunnel.
# При Custom Domains хостинга оставьте пустым.
CLOUDFLARED_TUNNEL_TOKEN=
